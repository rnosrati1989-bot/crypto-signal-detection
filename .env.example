# Binance API
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434

# Models Directory
MODELS_DIR=./models

# Database (Optional)
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_signals

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/crypto_signals.log

# Trading Settings
TEST_MODE=True
MAX_POSITION_SIZE=0.5
RISK_PER_TRADE=2.0

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
